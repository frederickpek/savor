# Copy to .env (git-ignored) and fill in. Used by local runs of `python -m pipeline.run`;
# CI reads the same names from repository secrets instead.
BELI_EMAIL=
BELI_PASSWORD=
# Alternative to email + password, if you already have one.
BELI_REFRESH_TOKEN=
# Optional: OneMap geocoding token for places Beli returns without coordinates.
ONEMAP_TOKEN=
